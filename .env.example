# Flask
PORT=5004

# Notion
# Internal integration token with read/update access to the task database.
NOTION_API_KEY="secret_xxx"
# Notion database ID for the task database.
DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Calendar OAuth user credentials
# Create an OAuth Client in Google Cloud, then use scripts/google_oauth_setup.py
# to generate GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
GOOGLE_REFRESH_TOKEN="1//xxxxxxxx"
# Dedicated calendar ID to sync into. Often an email address or ...@group.calendar.google.com.
GOOGLE_CALENDAR_ID="xxxxxxxx@group.calendar.google.com"
GOOGLE_TIME_ZONE="Europe/Berlin"

# Public base URL. No trailing slash.
PUBLIC_BASE_URL="https://<your-sync-host>"

# Sync endpoint protection
# PythonAnywhere scheduled task should call:
# https://<username>.pythonanywhere.com/sync?token=<SYNC_SECRET>
SYNC_SECRET="replace-with-a-long-random-string"

# Google Calendar push notifications
# Used as X-Goog-Channel-Token for /webhooks/google.
GOOGLE_WEBHOOK_TOKEN="replace-with-another-long-random-string"

# Notion webhook verification token
# Leave empty until Notion sends the one-time verification_token to /webhooks/notion,
# then paste that token here and reload the PythonAnywhere app.
NOTION_WEBHOOK_VERIFICATION_TOKEN=""

# GitHub auto-deploy webhook
# Must exactly match the Secret configured in GitHub Settings -> Webhooks.
GITHUB_WEBHOOK_SECRET="replace-with-a-different-long-random-string"
DEPLOY_BRANCH="main"
# Keep disabled unless the legacy PythonAnywhere GitHub deploy webhook is actively used.
ENABLE_LEGACY_DEPLOY_WEBHOOK="false"

# PythonAnywhere paths
REPO_PATH="/home/<pythonanywhere-username>/Notion-Calendar-Sync"
WSGI_FILE="/var/www/<pythonanywhere-username>_pythonanywhere_com_wsgi.py"
PYTHON_BIN="/home/<pythonanywhere-username>/.virtualenvs/notion-sync/bin/python"

# Local runtime state. Do not commit this directory.
VAR_DIR="/home/<pythonanywhere-username>/Notion-Calendar-Sync/var"
STATE_DB_PATH="/home/<pythonanywhere-username>/Notion-Calendar-Sync/var/sync_state.sqlite3"
SYNC_LOCK_PATH="/home/<pythonanywhere-username>/Notion-Calendar-Sync/var/sync.lock"
DEPLOY_LOCK_PATH="/home/<pythonanywhere-username>/Notion-Calendar-Sync/var/deploy.lock"

# Optional
NOTION_VERSION="2022-06-28"
